{
	"compilerOptions": {
		"module": "ES2022",
		"target": "ES2022",
		"moduleResolution": "Node",
		"sourceMap": true,
		"declaration": true,
		"forceConsistentCasingInFileNames": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strict": false
	},
	"include": ["unit-test/**/*", "index.ts", "common/**/*", "*.ts"]
}
